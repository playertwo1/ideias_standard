{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideias-standard.local/schemas/bundle.schema.json",
  "title": "Ideias Standard Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "profile", "packs"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "profile": {"enum": ["LIGHT", "STANDARD", "DEEP"]},
    "packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "adapters": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "workflow": {"type": ["string", "null"]},
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    }
  }
}
