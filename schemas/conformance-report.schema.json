{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideias-standard.local/schemas/conformance-report.schema.json",
  "title": "Ideias Standard Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "result", "checks"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "target": {"type": "string", "minLength": 1},
    "standard_version": {"type": ["string", "null"]},
    "result": {"enum": ["PASS", "FAIL", "WARN"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "severity", "message"],
        "properties": {
          "code": {"type": "string", "pattern": "^IS-[A-Z]+-[0-9]{3}$"},
          "status": {"enum": ["PASS", "FAIL", "WARN", "NOT_APPLICABLE"]},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "message": {"type": "string", "minLength": 1},
          "path": {"type": ["string", "null"]},
          "rationale": {"type": ["string", "null"]}
        }
      }
    }
  }
}
