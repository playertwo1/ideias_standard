{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideias-standard.local/schemas/workflow.schema.json",
  "title": "Ideias Standard Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "steps"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "gate"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "purpose": {"type": "string", "minLength": 1},
          "gate": {"type": "boolean"},
          "required_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []}
        }
      }
    }
  }
}
