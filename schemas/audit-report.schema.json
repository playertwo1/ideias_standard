{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideias-standard.local/schemas/audit-report.schema.json",
  "title": "Ideias Standard Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "audit_result", "audited_sha", "summary", "findings", "checks", "residual_risks", "gate_registration"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "role": {"type": "string", "const": "AUDITOR"},
    "audit_result": {"enum": ["PASS", "FAIL", "ESCALATE"]},
    "audited_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "blocking", "files", "evidence", "problem", "violated_criterion", "resolution_condition"], "properties": {"id": {"type": "string", "minLength": 1}, "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "blocking": {"type": "boolean"}, "files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence": {"type": "string", "minLength": 1}, "problem": {"type": "string", "minLength": 1}, "violated_criterion": {"type": "string", "minLength": 1}, "resolution_condition": {"type": "string", "minLength": 1}}}},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]}, "evidence": {"type": "string"}}}},
    "residual_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "gate_registration": {"type": "string", "const": "NOT_AUTHORIZED"}
  }
}
